FROM node:22-alpine
WORKDIR /app
ARG NEXT_PUBLIC_WORLD_ROOM_TABS=0
ARG NEXT_PUBLIC_WORLD_DEBUG=0
ENV NEXT_PUBLIC_WORLD_ROOM_TABS=${NEXT_PUBLIC_WORLD_ROOM_TABS}
ENV NEXT_PUBLIC_WORLD_DEBUG=${NEXT_PUBLIC_WORLD_DEBUG}
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
